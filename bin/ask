#!/usr/bin/env bash
# ask — send one prompt to another agent CLI and print its reply on stdout.
#
# Why this exists: every vendor spells the same three ideas differently
# (headless prompt, auto-approve, resume-by-id). Encoding those spellings in
# each agent's instructions means N copies that rot independently. Keeping them
# here means the instructions everywhere can just say `ask <vendor> "..."`, and
# a vendor renaming a flag is a one-line fix in one file.
#
#   ask grok "what breaks first in this design?"
#   ask codex "review the patch on stdin" < change.diff
#   ask claude --resume 0199... "and what about the retry path?"
#
# Exit codes: 2 = bad usage, 3 = CLI missing, 4 = CLI not authenticated.
# Anything else is the child's own exit code, passed through unchanged.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: ask <vendor> [--model <id>] [--resume <id>] [prompt]

  vendor   grok | codex | claude | deepseek
  prompt   the message; if omitted, read from stdin

  --model <id>    pin the model instead of taking the vendor's configured
                  default. Worth doing whenever the answer matters: the point
                  of asking a second vendor is a different model, and if you
                  did not name it you do not actually know what you asked.
  --resume <id>   continue an existing session instead of starting a new one
  --list          print which vendors are installed, and their default model

Examples:
  ask grok "attack the weakest part of this argument: ..."
  ask codex --model gpt-5.6-sol "review this design"
  echo "review this diff" | ask codex
  ask claude --resume 019f... "follow up on your last point"
EOF
  exit 2
}

# --- vendor probes ----------------------------------------------------------
# Each vendor gets a "is it installed" and "is it usable" answer. We keep the
# not-authenticated case separate from the not-installed case because the fixes
# are completely different, and a caller that conflates them debugs the wrong
# layer for a while.

vendor_cmd() {
  case "$1" in
    grok)     echo grok   ;;
    codex)    echo codex  ;;
    claude)   echo claude ;;
    deepseek) echo deepseek ;;
    *)        return 1 ;;
  esac
}

# Report the default each vendor would use when --model is omitted. Knowing
# this matters more than it looks: an unpinned cross-vendor comparison silently
# changes meaning whenever one of these configs is edited.
default_model() {
  case "$1" in
    grok)   grok models 2>/dev/null | sed -n 's/^Default model: //p' | head -1 ;;
    codex)  sed -n 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' \
              "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null | head -1 ;;
    *)      echo "" ;;
  esac
}

list_vendors() {
  for v in grok codex claude deepseek; do
    c="$(vendor_cmd "$v")"
    if command -v "$c" >/dev/null 2>&1; then
      d="$(default_model "$v")"
      printf '%-10s installed  %-28s default: %s\n' \
        "$v" "($(command -v "$c"))" "${d:-unknown}"
    else
      printf '%-10s missing\n' "$v"
    fi
  done
}

# --- argument parsing -------------------------------------------------------

[ $# -ge 1 ] || usage
[ "$1" = "--list" ] && { list_vendors; exit 0; }

vendor="$1"; shift
cmd="$(vendor_cmd "$vendor")" || { echo "ask: unknown vendor '$vendor'" >&2; usage; }

resume=""
model=""
while [ $# -gt 0 ]; do
  case "$1" in
    --resume) resume="${2:-}"; [ -n "$resume" ] || usage; shift 2 ;;
    --model|-m) model="${2:-}"; [ -n "$model" ] || usage; shift 2 ;;
    --help|-h) usage ;;
    --) shift; break ;;
    *) break ;;
  esac
done

# All three first-party CLIs spell this the same way, so the flag is assembled
# once here rather than per-vendor below. An empty array expands to nothing,
# which leaves the vendor's own default in charge.
model_flag=()
[ -n "$model" ] && model_flag=(--model "$model")

prompt="${1:-}"
if [ -z "$prompt" ]; then
  # No prompt argument: take it from stdin, but only if stdin is not a TTY.
  # Otherwise we would hang waiting for input the caller never intended to give.
  if [ -t 0 ]; then usage; fi
  prompt="$(cat)"
fi
[ -n "$prompt" ] || { echo "ask: empty prompt" >&2; exit 2; }

command -v "$cmd" >/dev/null 2>&1 || {
  echo "ask: '$cmd' is not installed or not on PATH" >&2
  exit 3
}

# --- dispatch ---------------------------------------------------------------
# Flag names below are the part most likely to drift. When a vendor renames
# something, fix it here; nothing else needs to change.

case "$vendor" in
  grok)
    # --always-approve (not --auto-approve) lets tool calls run unattended.
    if [ -n "$resume" ]; then
      exec grok -p "$prompt" --always-approve --resume "$resume" ${model_flag[@]+"${model_flag[@]}"}
    else
      exec grok -p "$prompt" --always-approve ${model_flag[@]+"${model_flag[@]}"}
    fi
    ;;

  codex)
    # codex refuses to start outside a Git repository unless told otherwise,
    # and a sandboxed child has no network by default — which matters as soon
    # as the task involves reaching any API.
    codex_args=(
      exec
      --skip-git-repo-check
      -s workspace-write
      -c sandbox_workspace_write.network_access=true
    )
    if [ -n "$resume" ]; then
      exec codex "${codex_args[@]}" ${model_flag[@]+"${model_flag[@]}"} resume "$resume" "$prompt"
    else
      exec codex "${codex_args[@]}" ${model_flag[@]+"${model_flag[@]}"} "$prompt"
    fi
    ;;

  claude)
    if [ -n "$resume" ]; then
      exec claude -p "$prompt" --resume "$resume" ${model_flag[@]+"${model_flag[@]}"}
    else
      exec claude -p "$prompt" ${model_flag[@]+"${model_flag[@]}"}
    fi
    ;;

  deepseek)
    # DeepSeek ships no first-party CLI; this slot is whatever wrapper you put
    # on PATH under that name. Model selection is the wrapper's business, so
    # --model is passed through only if it accepts one.
    exec deepseek ${model_flag[@]+"${model_flag[@]}"} "$prompt"
    ;;
esac
